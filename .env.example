# Credenciales del contenedor de PostgreSQL (docker-compose.yml)

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=agora_db

# Puerto del host donde se publica PostgreSQL.
# No es 5432 porque ese puerto lo ocupa el PostgreSQL instalado nativamente en
# Windows: las conexiones a localhost:5432 llegan a ese servidor y no al
# contenedor, y la autenticacion falla con un error P1000 enganoso.
POSTGRES_PORT=5433
