PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/DATABASE?schema=public"



JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Un solo origen, sin ruta. En producción es obligatoria: el dominio del cliente.
CORS_ORIGIN=http://localhost:4200

# Opcionales en desarrollo. Sin ellas, los archivos van a agora-backend/uploads/ y todo
# funciona. Son las tres o ninguna. En producción son obligatorias: el servidor no arranca.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=
