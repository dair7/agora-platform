                "exec": [
                  "pm.test('204 sin cuerpo', function () {\r\n  pm.response.to.have.status(204);\r\n});\r\n\r\npm.environment.unset('accessToken');\r\npm.environment.unset('refreshToken');"
                ]
              }
            }
