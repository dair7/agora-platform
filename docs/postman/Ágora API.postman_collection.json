    {
      "name": "auth",
      "item": [
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\r\n\r\npm.environment.set('accessToken', body.accessToken);\r\npm.environment.set('refreshToken', body.refreshToken);\r\n\r\npm.test('200 con los dos tokens', function () {\r\n  pm.response.to.have.status(200);\r\n  pm.expect(body.accessToken).to.be.a('string');\r\n  pm.expect(body.refreshToken).to.be.a('string');\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/iniciar-sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "iniciar-sesion"
              ]
            }
          },
          "response": []
        },
